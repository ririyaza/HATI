rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    // User document + ALL subcollections under the user
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // SPIN questions: app can read; writes should be admin-only
    match /spin_questions/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-only read access for the Developer Console's Assessments tab:
    // every user profile (name, email, initial SPIN) and every user's
    // post-assessment history. Read-only — admins can't edit scores.
    match /users/{userId} {
      allow read: if isAdmin();
    }
    match /{path=**}/reassessments/{reassessmentId} {
      allow read: if isAdmin();
    }

    // Admin-only read access for the Developer Console's Activity tab:
    // every user's scenario sessions and day-streak summary. Read-only.
    match /{path=**}/scenarios/{sessionId} {
      allow read: if isAdmin();
    }
    match /{path=**}/badge_progress/{docId} {
      allow read: if isAdmin();
    }

    // Admin-only cross-user read of Contact-Developer messages, plus
    // the ability to toggle their `read` flag — nothing else.
    match /{path=**}/supportMessages/{messageId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['read']);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
